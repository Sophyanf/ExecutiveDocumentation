<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:fa="http://schemas.fontawesome.io/icons/">

    <ImageBrush x:Key="WindBackgraund" ImageSource="pack://application:,,,/Resources/fon1.jpg" />


    <Style x:Key="WindowStyle" TargetType="{x:Type Window}">
        <Setter Property="AllowsTransparency" Value="True"/>
        <Setter Property="WindowStyle" Value="None"/>
       
        <Setter Property="AllowDrop" Value="True"/>
        <Setter Property="FontFamily"
                Value="Times New Roman" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="TextElement.Foreground" Value="#1E90FF" />
       
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border
                        Background="{ StaticResource WindBackgraund }">
                        
                        <ContentPresenter/>
                        
                    </Border>
                   
                </ControlTemplate>
            </Setter.Value>
        </Setter>


    </Style>

    
    <Style TargetType="Button" x:Key="MinimizeBtnStyle">
   
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="10,0,5,0" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <fa:ImageAwesome Icon="WindowMinimize"
                                                 Foreground="#CFDEEC"
                                                 Height="30"
                                                 x:Name="minimizeBtn"
                                                 />

                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <Style TargetType="Button" x:Key="MaximizeBtnStyle">
      
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="10,0,5,0" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <fa:ImageAwesome Icon="WindowMaximize"
                                                 Foreground="#CFDEEC"
                                                 Height="30"
                                                 />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Button" x:Key="CloseWindowBtnStyle">
        
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="10,0,0,0" />
        <Setter Property="BorderThickness" Value="1,1,1,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <fa:ImageAwesome Icon="WindowCloseOutline"
                                                 Foreground="#CFDEEC"
                                                 Height="30"
                                                 x:Name="closeBtn"
                                                 />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>