<Window x:Class="ExecutiveDocumentation.Views.MainView"
     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:ExecutiveDocumentation.Views"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:ExecutiveDocumentation.ViewModels"
        d:DataContext="{d:DesignInstance Type=vm:MainViewVM}"
        Height="{Binding SystemParameters.PrimaryScreenHeight}" Width="{Binding SystemParameters.PrimaryScreenWidth}" 
        Style="{StaticResource ResourceKey=WindowStyle}"
         >
  

    <Window.DataContext>
        <vm:MainViewVM x:Name="MainViewVM"></vm:MainViewVM>
    </Window.DataContext>

    <Grid MouseDown='OnDragMoveWindow'>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width='*' />
            <ColumnDefinition Width='Auto' />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical"> 
            <Border DockPanel.Dock="Top" Height="45" HorizontalAlignment="Right" Margin="0,10,10,0">
           
                 
                    <StackPanel Orientation="Horizontal"
                     HorizontalAlignment="Right"
                     >
                    <Button Style="{StaticResource ResourceKey=MinimizeBtnStyle}"
                     Command="{Binding WindowMinimizeCommand}"
                     />
                    <Button Style="{StaticResource ResourceKey=MaximizeBtnStyle}"
                     Command="{Binding WindowMaximizeCommand}"
                     />
                    <Button Style="{StaticResource ResourceKey=CloseWindowBtnStyle}"
                     Command="{Binding CloseWindowCommand}"
                     />
                </StackPanel>
           
        </Border>




            <StackPanel Orientation="Horizontal" Height="80"  Margin="0,20,20,0">

                <Button
                    Content="Создать объект" 
                    Margin="20,20,10,0"
                    Width="120"
                    Height ="40" Command="{Binding AddNewObjectDB}"
                />

                <Button
                    Content="Не работает" 
                    Margin="20,20,10,0"
                    Width="100"
                    Height ="40"  Command = "{Binding PrintDocumentCommand}"
                />
                <Button
                    Content="Не работает" 
                    Margin="20,20,10,0"
                    Width="100"
                    Height ="40" Command = "{Binding LoadFromExcelCommand}"
                />


            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin ="20, 10, 20 , 20" Background="Azure" >
                <StackPanel Orientation="Vertical"   >
                    <Label Content="Объект" 
                               Height="45"/>

                    <ListBox  Width="550" 
                          ItemsSource="{Binding ObjectsList}" 
                          DisplayMemberPath="ObjectAdress"
                          SelectedItem="{Binding SelectObject}"
                            
                        Height="550"
                        HorizontalAlignment="Left"
                        BorderBrush="Aqua"  
                          SelectedIndex="0">
                    </ListBox>

               
            </StackPanel>

            <StackPanel Orientation="Vertical"   
                        Margin="20, 0, 0,0"
                        >
                <Label Content="Данные объекта" 
                   Height="45"/>

                <TextBlock 
                    Text="{Binding SelectObject.ObjectName}"
                     TextWrapping="Wrap" 
                    Height="50" Width="400"/>

                <StackPanel Orientation="Horizontal" 
                           >
                    <Label Content="Заказчик" 
                        Height="50"/>
                    <TextBlock 
                        Margin="20, 0, 0,0"
                         Text="{Binding SelectObject.Customer}"
                          TextWrapping="Wrap" 
                         Height="50" />      
                </StackPanel>
                <StackPanel Orientation="Horizontal" 
            >
                    <Label Content="Шифр проекта" 
         Height="50"/>
                    <TextBlock 
         Margin="20, 0, 0,0"
          Text="{Binding SelectObject.ProjectForObject}"
           TextWrapping="Wrap" 
          Height="50" />
                </StackPanel>

            </StackPanel>
        </StackPanel>

    </StackPanel>
        </Grid>
</Window>
