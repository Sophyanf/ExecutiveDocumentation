<Window x:Class="ExecutiveDocumentation.Views.ObjectAddView"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:ExecutiveDocumentation.Views"
        mc:Ignorable="d"
        xmlns:vm="clr-namespace:ExecutiveDocumentation.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:ObjectAddViewVM}"
         Style="{StaticResource ResourceKey=WindowStyle}" 
         Width="1000" Height="650"
     >


    <Window.DataContext>
        <vm:ObjectAddViewVM x:Name="ObjectAddViewVM"></vm:ObjectAddViewVM>
    </Window.DataContext>


    <Grid Background="Transparent" MouseDown='OnDragMoveWindow'>
        <Grid.RowDefinitions>
            <RowDefinition Height="0*"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width='*' />
            <ColumnDefinition Width='Auto' />
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Vertical" Background="Transparent" Grid.RowSpan="2">
            <DockPanel  Background="Transparent" HorizontalAlignment ="Stretch" Height="60" VerticalAlignment="Center">
                <StackPanel  Margin="20,15,20,0" Orientation="Horizontal"  HorizontalAlignment ="Left" VerticalAlignment="Top">
                    <Image Source ="pack://application:,,,/Resources/logoNGM.png" />

                </StackPanel>
                <StackPanel  Margin="0,15,20,0" Orientation="Horizontal"  HorizontalAlignment ="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource ResourceKey=MinimizeBtnStyle}"
                  Command="{Binding WindowMinimizeCommand}"
                  />
                    <Button Style="{StaticResource ResourceKey=MaximizeBtnStyle}"
                  Command="{Binding WindowMaximizeCommand}"
                  />
                    <Button Style="{StaticResource ResourceKey=CloseWindowBtnStyle}"
                  Command="{Binding CloseWindowCommand}"
                  />
                </StackPanel>
            </DockPanel>


            <StackPanel Orientation="Vertical"  Height="500" Margin ="20, 15, 20 , 20" Background="White"  >


                <Label
                    Height="50"
                    HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                    Content="Данные объекта" 
                />

                <StackPanel Orientation="Horizontal" Height="40">


                    <Label
                    Width="350"
                    HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                    Content="Наименование объекта" 
                />



                    <TextBox 
                         Text="{Binding ObjName}"
                    Width="350"
                    Height="25"
                    HorizontalAlignment="Right"
                />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="40">
                    <Label Width="350"
                    HorizontalAlignment="Left"
                    Content="Адрес" 
                />
                    <TextBox Name ="tbAdress"
                    Width="350"
                    Height="25"
                         Text="{Binding ObjAdress}"
                    HorizontalAlignment="Right"
                   
                />

                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="40">
                    <Label Width="350"
                    HorizontalAlignment="Left"
                    Content="Заказчик" 
                />
                    <ComboBox Width="250"
                                  
                    ItemsSource="{Binding Kontragents}" 
                          DisplayMemberPath="KontragentShortName"
                          SelectedItem="{Binding SelectKontragent}"
                    Height="25"
                    HorizontalAlignment="Left"
                    BorderBrush="Aqua"  
                          SelectedIndex="0">
                    </ComboBox>

                    <Button 
                       Width="90"
                        Height="30"
                        Margin="30,0"
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Center"
                        Content="Создать"
                        Command="{Binding AddNewKontragent }"
                        
                        >
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="40">
                    <Label Width="350"
                    HorizontalAlignment="Left"
                    Content="Дата начала строительства" 
                />
                    <DatePicker 
                    SelectedDate="{Binding StartDate}"
                    Width="200"
                    Height="30"
                    HorizontalAlignment="Left"
                />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="40">
                    <Label 
                        Width="350"
                    HorizontalAlignment="Left"
                    Content="Дата окончания строительства" 
                />
                    <DatePicker Name ="dpFinish"
                            SelectedDate="{Binding EndDate}"
                            
                    Width="200"
                    Height="30"
                    HorizontalAlignment="Left"
                />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="40" >
                    <Label Width="350"
                    HorizontalAlignment="Left"
                    Content="Данные проекта" 
                />

                    <Button Background="Transparent"
                       Width="250"
                    Height="30"
                        Foreground="Blue"
                        FontStyle="Oblique"
                        ContentStringFormat="Underline"
                        HorizontalAlignment="Left"  
                        VerticalAlignment="Center"
                        Command="{Binding AddNewProject}"
                        >

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="{Binding ProjectStr}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlagProject }" Value="true">
                                        <Setter Property="Content" Value="Введите данные проекта" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="70"  HorizontalAlignment="Center"   >
                    <Button 
                       Width="150"
                        Height="30"
                        
                        HorizontalAlignment="Center"  
                        VerticalAlignment="Top"
                        Content="Создать объект"
                        Command="{Binding AddNewConctrObject}"
                        
                        >
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Height="40">
                    <Label Width="350"
                    HorizontalAlignment="Left"
                    Content="Виды работ" 
                />
                    <Button Background="Transparent"
                       Width="250"
                    Height="30"
                        Foreground="Blue"
                        FontStyle="Oblique"
                        ContentStringFormat="Underline"
                        HorizontalAlignment="Left"  
                        VerticalAlignment="Center"
                        Command="{Binding AddWorksList}"
                        >

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Content" Value="{}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FlagListOfWorks}" Value="true">
                                        <Setter Property="Content" Value="Выберите работы для данного объекта" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <Button
                    Content="Загрузить" 
                    Margin="0,0,0,20"
                    Width="90"
                    Height ="40" Command="{Binding AddNewObject}"
                />

            </StackPanel>
        </StackPanel>

    </Grid>

</Window>
